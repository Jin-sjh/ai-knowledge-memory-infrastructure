{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas reference object bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sources",
    "evidence",
    "items",
    "checkpoints",
    "artifacts"
  ],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "kind",
        "id"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "user",
            "project",
            "organization"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "instant": {
      "type": "string",
      "format": "date-time"
    }
  },
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "scope",
          "content",
          "recorded_at",
          "acl_version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "scope": {
            "$ref": "#/$defs/scope"
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "recorded_at": {
            "$ref": "#/$defs/instant"
          },
          "acl_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "locator",
          "quote"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$ref": "#/$defs/ref"
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "section",
                  "offset",
                  "message",
                  "field"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "scope",
          "semantic_type",
          "uses",
          "content",
          "evidence_ids",
          "valid_from",
          "valid_to",
          "recorded_at",
          "status",
          "verification",
          "supersedes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "scope": {
            "$ref": "#/$defs/scope"
          },
          "semantic_type": {
            "enum": [
              "fact",
              "concept",
              "entity",
              "relation",
              "rule",
              "event",
              "preference",
              "experience",
              "procedure"
            ]
          },
          "uses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "knowledge",
                "memory"
              ]
            }
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "valid_from": {
            "$ref": "#/$defs/instant"
          },
          "valid_to": {
            "anyOf": [
              {
                "$ref": "#/$defs/instant"
              },
              {
                "type": "null"
              }
            ]
          },
          "recorded_at": {
            "$ref": "#/$defs/instant"
          },
          "status": {
            "enum": [
              "candidate",
              "active",
              "disputed",
              "superseded",
              "tombstoned",
              "purged"
            ]
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "state"
            ],
            "properties": {
              "method": {
                "enum": [
                  "source_review",
                  "user_statement",
                  "unverified"
                ]
              },
              "state": {
                "enum": [
                  "unverified",
                  "supported",
                  "disputed"
                ]
              }
            }
          },
          "supersedes": {
            "anyOf": [
              {
                "$ref": "#/$defs/ref"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "version",
          "scope",
          "step",
          "side_effects"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "scope": {
            "$ref": "#/$defs/scope"
          },
          "step": {
            "type": "string",
            "minLength": 1
          },
          "side_effects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "state",
                "remote_id"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "state": {
                  "enum": [
                    "planned",
                    "confirmed",
                    "unknown"
                  ]
                },
                "remote_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "kind",
          "depends_on",
          "builder_version",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "chunk",
              "wiki",
              "graph",
              "vector",
              "context"
            ]
          },
          "depends_on": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "builder_version": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "building",
              "ready",
              "stale",
              "deleted"
            ]
          }
        }
      }
    }
  }
}
